{
  "name": "extension-nest",
  "displayName": "Extension Nest",
  "description": "%description%",
  "version": "1.0.0",
  "private": true,
  "publisher": "Lazenca",
  "icon": "media/extension-nest-icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:extensionNest.groups",
    "onCommand:extensionNest.openDashboard",
    "onCommand:extensionNest.createGroup"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "npm --prefix webview run build && node esbuild.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.extension.json",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --out extension-nest-1.0.0.vsix"
  },
  "contributes": {
    "colors": [
      {
        "id": "extensionNest.group.purple",
        "description": "%color.purple%",
        "defaults": {
          "dark": "#7C3AED",
          "light": "#7C3AED",
          "highContrast": "#B69AFF",
          "highContrastLight": "#5920B0"
        }
      },
      {
        "id": "extensionNest.group.blue",
        "description": "%color.blue%",
        "defaults": {
          "dark": "#2563EB",
          "light": "#2563EB",
          "highContrast": "#86B7FF",
          "highContrastLight": "#1541A3"
        }
      },
      {
        "id": "extensionNest.group.orange",
        "description": "%color.orange%",
        "defaults": {
          "dark": "#D97706",
          "light": "#D97706",
          "highContrast": "#FFBF69",
          "highContrastLight": "#874300"
        }
      },
      {
        "id": "extensionNest.group.green",
        "description": "%color.green%",
        "defaults": {
          "dark": "#059669",
          "light": "#059669",
          "highContrast": "#6EE7B7",
          "highContrastLight": "#006644"
        }
      },
      {
        "id": "extensionNest.group.pink",
        "description": "%color.pink%",
        "defaults": {
          "dark": "#DB2777",
          "light": "#DB2777",
          "highContrast": "#FF9CCB",
          "highContrastLight": "#A01050"
        }
      },
      {
        "id": "extensionNest.group.cyan",
        "description": "%color.cyan%",
        "defaults": {
          "dark": "#0EA5E9",
          "light": "#0EA5E9",
          "highContrast": "#7DD3FC",
          "highContrastLight": "#006A99"
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "extensionNest",
          "title": "Extension Nest",
          "icon": "media/extension-nest.svg"
        }
      ]
    },
    "views": {
      "extensionNest": [
        {
          "id": "extensionNest.groups",
          "name": "Extension Nest",
          "contextualTitle": "Extension Nest",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "extensionNest.repairData",
        "title": "%command.repairData%",
        "category": "Extension Nest"
      },
      {
        "command": "extensionNest.inspectCapabilities",
        "title": "%command.inspectCapabilities%",
        "category": "Extension Nest"
      },
      {
        "command": "extensionNest.openDashboard",
        "title": "%command.openDashboard%",
        "icon": "$(dashboard)",
        "category": "Extension Nest"
      },
      {
        "command": "extensionNest.showGroups",
        "title": "%command.showGroups%",
        "category": "Extension Nest"
      },
      {
        "command": "extensionNest.createGroup",
        "title": "%command.createGroup%",
        "icon": "$(add)",
        "category": "Extension Nest"
      },
      {
        "command": "extensionNest.renameGroup",
        "title": "%command.renameGroup%",
        "category": "Extension Nest"
      },
      {
        "command": "extensionNest.deleteGroup",
        "title": "%command.deleteGroup%",
        "category": "Extension Nest"
      },
      {
        "command": "extensionNest.setTags",
        "title": "%command.setTags%",
        "category": "Extension Nest"
      },
      {
        "command": "extensionNest.groupUp",
        "title": "%command.groupUp%",
        "category": "Extension Nest"
      },
      {
        "command": "extensionNest.groupDown",
        "title": "%command.groupDown%",
        "category": "Extension Nest"
      },
      {
        "command": "extensionNest.extensionUp",
        "title": "%command.extensionUp%",
        "category": "Extension Nest"
      },
      {
        "command": "extensionNest.extensionDown",
        "title": "%command.extensionDown%",
        "category": "Extension Nest"
      },
      {
        "command": "extensionNest.sortExtensions",
        "title": "%command.sortExtensions%",
        "category": "Extension Nest"
      },
      {
        "command": "extensionNest.refresh",
        "title": "%command.refresh%",
        "category": "Extension Nest",
        "icon": "$(refresh)"
      },
      {
        "command": "extensionNest.openExtension",
        "title": "%command.openExtension%",
        "category": "Extension Nest"
      },
      {
        "command": "extensionNest.copyId",
        "title": "%command.copyId%",
        "category": "Extension Nest"
      },
      {
        "command": "extensionNest.cleanupUnverified",
        "title": "%command.cleanupUnverified%",
        "category": "Extension Nest"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "extensionNest.openDashboard",
          "when": "view == extensionNest.groups",
          "group": "navigation"
        },
        {
          "command": "extensionNest.createGroup",
          "when": "view == extensionNest.groups",
          "group": "navigation"
        },
        {
          "command": "extensionNest.refresh",
          "when": "view == extensionNest.groups",
          "group": "navigation"
        },
        {
          "command": "extensionNest.cleanupUnverified",
          "when": "view == extensionNest.groups",
          "group": "cleanup"
        }
      ],
      "view/item/context": [
        {
          "command": "extensionNest.openDashboard",
          "when": "view == extensionNest.groups && (viewItem == extensionNest.group || viewItem == extensionNest.ungrouped || viewItem =~ /^extensionNest\\.extension/)",
          "group": "inline"
        },
        {
          "command": "extensionNest.renameGroup",
          "when": "view == extensionNest.groups && viewItem == extensionNest.group",
          "group": "group"
        },
        {
          "command": "extensionNest.deleteGroup",
          "when": "view == extensionNest.groups && viewItem == extensionNest.group",
          "group": "group"
        },
        {
          "command": "extensionNest.setTags",
          "when": "view == extensionNest.groups && viewItem =~ /^extensionNest\\.extension/",
          "group": "manage@4"
        },
        {
          "command": "extensionNest.groupUp",
          "when": "view == extensionNest.groups && viewItem == extensionNest.group",
          "group": "sort"
        },
        {
          "command": "extensionNest.groupDown",
          "when": "view == extensionNest.groups && viewItem == extensionNest.group",
          "group": "sort"
        },
        {
          "command": "extensionNest.extensionUp",
          "when": "view == extensionNest.groups && viewItem =~ /^extensionNest\\.extension/",
          "group": "sort"
        },
        {
          "command": "extensionNest.extensionDown",
          "when": "view == extensionNest.groups && viewItem =~ /^extensionNest\\.extension/",
          "group": "sort"
        },
        {
          "command": "extensionNest.sortExtensions",
          "when": "view == extensionNest.groups && (viewItem == extensionNest.group || viewItem == extensionNest.ungrouped)",
          "group": "sort"
        },
        {
          "command": "extensionNest.openExtension",
          "when": "view == extensionNest.groups && viewItem == extensionNest.extension",
          "group": "navigation"
        },
        {
          "command": "extensionNest.copyId",
          "when": "view == extensionNest.groups && viewItem == extensionNest.extension",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Extension Nest",
      "properties": {
        "extensionNest.showBuiltinExtensions": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.showBuiltinExtensions%"
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/vscode": "1.137.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "extensionKind": [
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Li-Lazenca-Qiuqi/Extension-nest.git"
  }
}
