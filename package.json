{
  "name": "extension-nest-demo",
  "displayName": "Extension Nest Demo",
  "description": "A native VS Code TreeView and editor Dashboard demo for organizing extensions.",
  "version": "0.1.2",
  "private": true,
  "publisher": "local-demo",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:extensionNest.groups",
    "onCommand:extensionNest.openDashboard",
    "onCommand:extensionNest.createGroup"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "npm --prefix demo run build && node esbuild.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.extension.json",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --skip-license --readme-path demo/INSTALL.md --out extension-nest-demo.vsix"
  },
  "contributes": {
    "colors": [
      { "id": "extensionNest.group.purple", "description": "Extension Nest 紫色分类图标", "defaults": { "dark": "#7C3AED", "light": "#7C3AED", "highContrast": "#B69AFF", "highContrastLight": "#5920B0" } },
      { "id": "extensionNest.group.blue", "description": "Extension Nest 蓝色分类图标", "defaults": { "dark": "#2563EB", "light": "#2563EB", "highContrast": "#86B7FF", "highContrastLight": "#1541A3" } },
      { "id": "extensionNest.group.orange", "description": "Extension Nest 橙色分类图标", "defaults": { "dark": "#D97706", "light": "#D97706", "highContrast": "#FFBF69", "highContrastLight": "#874300" } },
      { "id": "extensionNest.group.green", "description": "Extension Nest 绿色分类图标", "defaults": { "dark": "#059669", "light": "#059669", "highContrast": "#6EE7B7", "highContrastLight": "#006644" } },
      { "id": "extensionNest.group.pink", "description": "Extension Nest 粉色分类图标", "defaults": { "dark": "#DB2777", "light": "#DB2777", "highContrast": "#FF9CCB", "highContrastLight": "#A01050" } },
      { "id": "extensionNest.group.cyan", "description": "Extension Nest 青色分类图标", "defaults": { "dark": "#0EA5E9", "light": "#0EA5E9", "highContrast": "#7DD3FC", "highContrastLight": "#006A99" } }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "extensionNest", "title": "Extension Nest", "icon": "media/extension-nest.svg" }
      ]
    },
    "views": {
      "extensionNest": [
        {
          "id": "extensionNest.groups",
          "name": "Extension Nest Demo",
          "contextualTitle": "Extension Nest Demo",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "extensionNest.openDashboard",
        "title": "Open Extension Nest Dashboard",
        "icon": "$(dashboard)",
        "category": "Extension Nest Demo"
      },
      {
        "command": "extensionNest.showGroups",
        "title": "Show Extension Nest Groups",
        "category": "Extension Nest Demo"
      },
      {
        "command": "extensionNest.createGroup",
        "title": "Create Demo Group",
        "icon": "$(add)",
        "category": "Extension Nest Demo"
      },
      {
        "command": "extensionNest.renameGroup",
        "title": "Rename Demo Group",
        "category": "Extension Nest Demo"
      },
      {
        "command": "extensionNest.deleteGroup",
        "title": "Delete Demo Group",
        "category": "Extension Nest Demo"
      },
      {
        "command": "extensionNest.moveToGroup",
        "title": "Move Demo Extension to Group",
        "category": "Extension Nest Demo"
      },
      {
        "command": "extensionNest.toggle",
        "title": "Toggle Demo Extension",
        "category": "Extension Nest Demo"
      },
      {
        "command": "extensionNest.update",
        "title": "Update Demo Extension",
        "category": "Extension Nest Demo"
      },
      {
        "command": "extensionNest.setTags",
        "title": "Edit Demo Extension Tags",
        "category": "Extension Nest Demo"
      },
      {
        "command": "extensionNest.resetDemo",
        "title": "Reset Extension Nest Demo",
        "category": "Extension Nest Demo"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "extensionNest.openDashboard",
          "when": "view == extensionNest.groups",
          "group": "navigation"
        },
        {
          "command": "extensionNest.createGroup",
          "when": "view == extensionNest.groups",
          "group": "navigation"
        },
        {
          "command": "extensionNest.resetDemo",
          "when": "view == extensionNest.groups",
          "group": "tools"
        }
      ],
      "view/item/context": [
        {
          "command": "extensionNest.openDashboard",
          "when": "view == extensionNest.groups && (viewItem == extensionNest.group || viewItem == extensionNest.ungrouped || viewItem =~ /^extensionNest\\.extension/)",
          "group": "inline"
        },
        {
          "command": "extensionNest.renameGroup",
          "when": "view == extensionNest.groups && viewItem == extensionNest.group",
          "group": "group"
        },
        {
          "command": "extensionNest.deleteGroup",
          "when": "view == extensionNest.groups && viewItem == extensionNest.group",
          "group": "group"
        },
        {
          "command": "extensionNest.moveToGroup",
          "when": "view == extensionNest.groups && viewItem =~ /^extensionNest\\.extension/",
          "group": "manage@1"
        },
        {
          "command": "extensionNest.toggle",
          "when": "view == extensionNest.groups && viewItem =~ /^extensionNest\\.extension/",
          "group": "manage@2"
        },
        {
          "command": "extensionNest.update",
          "when": "view == extensionNest.groups && viewItem =~ /^extensionNest\\.extension/",
          "group": "manage@3"
        },
        {
          "command": "extensionNest.setTags",
          "when": "view == extensionNest.groups && viewItem =~ /^extensionNest\\.extension/",
          "group": "manage@4"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/vscode": "1.137.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
